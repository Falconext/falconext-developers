# ─── NextAuth (Auth.js v5) ─────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=

# ─── Backend Falconext MyPE ────────────────────────────────────────────
# URL del backend (default: http://localhost:4001/api)
MYPE_API_URL=http://localhost:4001/api

# Shared secret entre este portal y el backend de MyPE para el endpoint
# /auth/oauth-signin. Debe coincidir con OAUTH_SIGNIN_SECRET del backend.
# Genera con: openssl rand -base64 48
OAUTH_SIGNIN_SECRET=

# ─── OAuth providers (opcionales) ─────────────────────────────────────
# Deja vacío para deshabilitar. Los devs pueden usar credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_ID=
GITHUB_SECRET=
